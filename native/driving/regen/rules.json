{
 "call_bridge": ["^(\\s*PUSH32\\(esp, 0x[0-9A-F]+u\\); )(RECOMP_ABI_CALL\\()", "\\1g_ebp = g_seh_ebp = ebp; \\2"],
 "ebp_from_caller": ["^(\\s*uint32_t ebp);$", "\\1 = g_ebp;"],
 "ebp_from_caller_noted": ["^(\\s*uint32_t ebp);$", "\\1 = g_ebp; /* preserve original incoming EBP */"],
 "pop_ebp_publish": ["^(\\s*POP32\\(esp, ebp\\);)$", "\\1 g_ebp=g_seh_ebp=ebp;"],
 "pop_ebp_publish_spaced": ["^(\\s*POP32\\(esp, ebp\\);)$", "\\1 g_ebp = g_seh_ebp = ebp;"],
 "pop_ebp_publish_noted": ["^(\\s*POP32\\(esp, ebp\\);)$", "\\1 g_ebp = g_seh_ebp = ebp; /* publish guest EBP register */"],
 "ebp_write_publish": ["^(\\s*ebp = [^;]+;)$", "\\1 g_ebp = g_seh_ebp = ebp; /* publish guest EBP register */"]
}
